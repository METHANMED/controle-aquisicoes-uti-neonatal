# ============================================================================
# Controle de Aquisições — UTI Neonatal
# Arquivo de configuração de exemplo
# ============================================================================
# Copie este arquivo para .env e preencha os valores reais antes de executar.
# NÃO COMMITE .env com valores sensíveis no repositório.

# ============================================================================
# BANCO DE DADOS (obrigatório)
# ============================================================================
# Conexão MySQL/TiDB para armazenar equipamentos, etapas, usuários e cotações.
# Formato: mysql://usuario:senha@host:porta/banco_de_dados
DATABASE_URL=mysql://root:senha@localhost:3306/controle_aquisicoes

# ============================================================================
# AUTENTICAÇÃO (obrigatório)
# ============================================================================
# Chave secreta para assinar cookies de sessão (use uma string aleatória forte).
JWT_SECRET=sua_chave_secreta_muito_forte_aqui_minimo_32_caracteres

# ============================================================================
# LOGIN (obrigatório)
# ============================================================================
# Login por email/senha, próprio da aplicação (não depende de nenhum provedor
# externo). Na primeira inicialização do servidor, uma conta de administrador
# é criada (ou atualizada) automaticamente com estes valores — use-a para
# entrar pela primeira vez e depois cadastre outras pessoas pela tela
# "Acessos" dentro do sistema.
ADMIN_EMAIL=voce@exemplo.com
ADMIN_PASSWORD=escolha_uma_senha_forte
OWNER_NAME=Nome do Proprietário

# ============================================================================
# OAUTH (opcional — legado do Manus, não é necessário para login)
# ============================================================================
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=

# ============================================================================
# ARMAZENAMENTO DE ARQUIVOS (opcional, para notas fiscais e documentos)
# ============================================================================
# Se usar S3 ou compatível para armazenar arquivos:
# AWS_ACCESS_KEY_ID=sua_chave_acesso_aws
# AWS_SECRET_ACCESS_KEY=sua_chave_secreta_aws
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=seu_bucket_s3

# ============================================================================
# AMBIENTE
# ============================================================================
NODE_ENV=production

# ============================================================================
# VARIÁVEIS ESPECÍFICAS DO MANUS (se usar integração com Manus)
# ============================================================================
# Essas variáveis são injetadas automaticamente pelo Manus.
# Se executar fora do Manus, deixe em branco ou remova.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
VITE_APP_TITLE=MethanMed — Controle de Aquisições
VITE_APP_LOGO=
